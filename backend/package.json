{
  "name": "animeverse-ai-backend",
  "version": "1.0.0",
  "description": "AnimeVerse AI backend — anime video + community platform with AI features",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "ingest:anime": "node src/scripts/ingestAnime.js",
    "ingest:jikan": "node src/scripts/ingestJikan.js",
    "ingest:curated": "node src/scripts/ingestCuratedAnime.js",
    "ingest:youtube": "node src/scripts/ingestYouTube.js",
    "backfill:embeddings": "node src/scripts/backfillEmbeddings.js",
    "test": "node --test",
    "grow:catalog": "node src/scripts/growCatalog.js",
    "seed:community": "node src/scripts/seedCommunity.js",
    "deploy:check": "node src/scripts/deploymentCheck.js",
    "deploy:check:db": "node src/scripts/deploymentCheck.js --db",
    "test:hardening": "node --test tests/productionHardening.test.mjs",
    "catalog:audit": "node src/scripts/auditCatalogQuality.js",
    "catalog:audit:live": "node src/scripts/auditCatalogQuality.js --live",
    "catalog:quarantine": "node src/scripts/auditCatalogQuality.js --live --quarantine",
    "catalog:associations": "node src/scripts/auditCatalogAssociations.js",
    "catalog:associations:apply": "node src/scripts/auditCatalogAssociations.js --apply",
    "rag:index": "node src/scripts/buildRagIndex.js",
    "rag:index:dry": "node src/scripts/buildRagIndex.js --dry-run",
    "test:rag": "node --test tests/ragFoundation.test.mjs tests/ragEvaluation.test.mjs tests/ragCitationIds.test.mjs",
    "rag:evaluate": "node src/scripts/evaluateRag.js"
  },
  "keywords": [
    "animeverse",
    "youtube-clone",
    "ai",
    "mern"
  ],
  "author": "Sreelekha Nampally",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^2.2.0",
    "openai": "^4.68.0"
  }
}
