# --- Server ---
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# --- JWT ---
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI provider (OpenAI) ---
# Optional legacy provider. Required only for the older OpenAI-backed video summary,
# auto-tagging, sentiment, translation, ask-video and Whisper routes. AnimeVerse
# semantic search and the new grounded /ai/chat do NOT require this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Unused: the embedding model is NOT env-configurable. Dimension count is a hard
# property of a model, so a typo here would produce vectors that pass validation and
# are still incompatible. See src/config/embedding.config.js.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Embeddings ---
# Which provider generates vectors. One of: local | openai
#
#   local  (default) sentence-transformers/all-MiniLM-L6-v2, 384 dimensions.
#          Runs in-process via ONNX Runtime. No API key, no cost, no rate limit.
#          First run downloads ~90MB of weights to backend/.model-cache/ and every
#          run afterwards is fully offline.
#   openai text-embedding-3-small, 1536 dimensions. Requires OPENAI_API_KEY and
#          consumes credits per document.
#
# The two are NOT interchangeable on an indexed corpus: switching providers changes
# the vector width and invalidates every stored vector, which the embeddingVersion
# stamp makes explicit. A switch means a full re-run of `npm run backfill:embeddings`.
EMBEDDING_PROVIDER=local
# Where the local model's weights are cached. Defaults to backend/.model-cache/.
# Set this to share one download across several deployments.
# LOCAL_EMBEDDING_CACHE_DIR=


# --- AnimeVerse Assistant V2 (free-first) ---
# auto      -> prefer Gemini when GEMINI_API_KEY exists; otherwise try local Ollama;
#              finally fall back to local retrieval. Gemini quota/network failures also
#              degrade gracefully instead of taking the public demo offline.
# gemini    -> prefer Gemini but still keep the local emergency fallback.
# ollama    -> require the configured local Ollama model.
# retrieval -> always use the built-in local retrieval composer.
ANIME_CHAT_PROVIDER=auto

# Gemini Developer API. Keep this SERVER-SIDE only. The default model is selected
# for the developer free tier; no paid OpenAI API is required for Anime Chat.
# Create a key in Google AI Studio and place the real value only in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional free-tier failover order if the primary model is throttled/unavailable.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=20000

# Optional fully-local provider/fallback.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- AniList metadata ingestion (all optional; defaults are built in) ---
# The public AniList GraphQL API needs no key and no account.
# ANILIST_API_URL=https://graphql.anilist.co
# Minimum gap between requests. The live API advertises 30 req/min through
# x-ratelimit-limit, so ~2.2s keeps a comfortable margin under it.
# ANILIST_MIN_SPACING_MS=2200
# ANILIST_MAX_RETRIES=3
# ANILIST_TIMEOUT_MS=20000


# --- Jikan / MyAnimeList metadata fallback (optional; no API key required) ---
# JIKAN_API_URL=https://api.jikan.moe/v4
# JIKAN_MIN_SPACING_MS=1100
# JIKAN_MAX_RETRIES=4
# JIKAN_TIMEOUT_MS=20000

# --- YouTube Data API v3 (server-side only, required for `npm run ingest:youtube`) ---
# Create a key at https://console.cloud.google.com -> APIs & Services -> Credentials,
# with the "YouTube Data API v3" enabled. Server-side only: it is never sent to the
# frontend and never stored in MongoDB.
YOUTUBE_API_KEY=
# YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
# YOUTUBE_TIMEOUT_MS=20000

# --- Optional: Vector DB (falls back to in-Mongo cosine if unset) ---
VECTOR_PROVIDER=mongo
# PINECONE_API_KEY=
# PINECONE_INDEX=animeverse-videos

# --- Optional: Redis (for caching AI results) ---
# REDIS_URL=redis://localhost:6379
